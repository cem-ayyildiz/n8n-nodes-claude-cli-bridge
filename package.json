{
  "name": "n8n-nodes-claude-cli-bridge",
  "version": "1.0.0",
  "description": "n8n community node for the locally-installed, subscription-authenticated Claude CLI that takes attachments: images and PDFs go to Claude as they are, so Claude reads the photo or the PDF pages itself. No Anthropic API key, no separate server.",
  "keywords": [
    "n8n-community-node-package",
    "claude",
    "anthropic",
    "claude-code",
    "vision",
    "pdf",
    "attachments",
    "image",
    "multimodal",
    "ocr",
    "document",
    "heic"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cem-ayyildiz/n8n-nodes-claude-cli-bridge",
  "author": {
    "name": "Cem Ayyildiz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cem-ayyildiz/n8n-nodes-claude-cli-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/cem-ayyildiz/n8n-nodes-claude-cli-bridge/issues"
  },
  "engines": {
    "node": ">=18.10"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/**/*.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ClaudeCliBridgeApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ClaudeCliBridge/ClaudeCliBridge.node.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "n8n-workflow": "^1.60.0",
    "typescript": "^5.5.0"
  }
}
